# Copy to beta.env in the stack folder on the server (never commit the copy).
# ENVIRONMENT, SANDBOX_MODE, DISCORD_GATEWAY, RACETIME_BOT_ENABLED, DB_HOST and
# NICEGUI_REDIS_URL are set by docker-compose.yml.

# The backend's own address: sign-in, the API and the current site on beta data.
BASE_URL=https://wizzrobe-beta-api.synack.live

# Where the new app is served; the seed registers it as the app's sign-in return.
APP_REDIRECT_URIS=https://wizzrobe-beta.synack.live/auth/callback

# The beta database on the host's Postgres (see README.md for creating it).
DB_NAME=wizzrobe_beta
DB_USERNAME=wizzrobe_beta
DB_PASSWORD=
DB_PORT=5432

# 32+ random characters, different from production's:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
STORAGE_SECRET=

# Sign-in only: production's Discord application, with
# https://wizzrobe-beta-api.synack.live/oauth/callback added as a redirect.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Leave these out on beta. SANDBOX_MODE blocks the sends anyway, but without the
# keys nothing even tries: DISCORD_TOKEN, SENDGRID_API_KEY, TELEGRAM_BOT_TOKEN,
# VAPID_PRIVATE_KEY, APNS_*, FCM_*, and every Challonge, start.gg, Twitch,
# racetime, Matcherino, Patreon, Stripe and PayPal credential.

# The proxy in README.md appends to X-Forwarded-For, so rate limits read the last entry.
TRUST_PROXY_FORWARDED_FOR=last

# Optional: report beta errors to Sentry under their own environment.
# SENTRY_DSN=

# Shared with the Door Randomizer sidecar; the same value goes in door-rando.env.
# DOOR_RANDO_TOKEN=
