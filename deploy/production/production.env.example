# Copy to production.env in the stack folder on the server (never commit the copy)
# and chmod 600 it. Start from production's current .env: every setting it has
# carries over unchanged. docker-compose.yml sets these itself, per container, so
# leave them out or they're ignored: DB_HOST, NICEGUI_REDIS_URL, DISCORD_GATEWAY,
# SEPARATE_BOTS, and RACETIME_BOT_ENABLED for the API.

ENVIRONMENT=production
BASE_URL=https://yourdomain.example

# Production's database on the host's Postgres.
DB_NAME=wizzrobe
DB_USERNAME=wizzrobe
DB_PASSWORD=
DB_PORT=5432

STORAGE_SECRET=

DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Shared with the Door Randomizer sidecar; the same value goes in door-rando.env.
# DOOR_RANDO_TOKEN=

# The bots container runs the racetime room bot when this is on (as production
# has it today, if it does). The API always has it off.
# RACETIME_BOT_ENABLED=on

# ...and everything else production's .env has today (TRUST_PROXY_FORWARDED_FOR,
# Sentry, Challonge,
# start.gg, Twitch, racetime, Matcherino, SendGrid, Telegram, VAPID, Patreon,
# Stripe, PayPal).
