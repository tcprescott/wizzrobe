[
  {
    "name": "linked",
    "user": "staff_user",
    "viewport": {
      "width": 1280,
      "height": 900
    },
    "path": "/admin/tournaments",
    "selector": ".q-page",
    "setup": [
      {
        "fill": "input[placeholder^='Search tournaments']",
        "value": "Wizzrobe Dev"
      },
      {
        "wait": 600
      },
      {
        "click": "[aria-label=\"More for Wizzrobe Dev Tournament\"] >> visible=true"
      },
      {
        "waitFor": ".q-menu"
      },
      {
        "wait": 400
      }
    ],
    "annotate": [
      {
        "selector": "th:has-text('Bracket')",
        "n": 1
      },
      {
        "selector": "[aria-label=\"More for Wizzrobe Dev Tournament\"] >> visible=true",
        "n": 2
      },
      {
        "selector": ".q-menu .q-item:has-text('Match entrants to members')",
        "n": 3
      }
    ],
    "padding": 0
  },
  {
    "name": "entrants",
    "user": "staff_user",
    "viewport": "desktop",
    "path": "/admin/tournaments",
    "setup": [
      {
        "fill": "input[placeholder^='Search tournaments']",
        "value": "Wizzrobe Dev"
      },
      {
        "wait": 600
      },
      {
        "click": "[aria-label=\"More for Wizzrobe Dev Tournament\"] >> visible=true"
      },
      {
        "click": ".q-menu .q-item:has-text(\"Match entrants to members\")"
      },
      {
        "waitFor": ".q-dialog"
      },
      {
        "wait": 600
      }
    ],
    "selector": ".q-dialog .q-card",
    "padding": 0,
    "annotate": [
      {
        "selector": ".q-dialog .q-select >> nth=0",
        "n": 1
      },
      {
        "selector": ".q-dialog button:has-text('Assign') >> nth=0",
        "n": 2
      },
      {
        "selector": ".q-dialog button:has-text('Clear') >> nth=0",
        "n": 3
      }
    ]
  }
]
