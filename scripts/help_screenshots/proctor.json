[
  {
    "name": "board-phone",
    "user": "proctor_user",
    "path": "/volunteer/proctor-station",
    "selector": ".run-sheet__card--split:has-text('ADA'):has-text('Check in')",
    "setup": [
      {
        "wait": 1500
      }
    ],
    "annotate": [
      {
        "selector": ".run-sheet__card--split:has-text('ADA'):has-text('Check in') >> button:has-text('Check in')",
        "n": 1
      }
    ]
  },
  {
    "name": "check-in-phone",
    "user": "proctor_user",
    "path": "/volunteer/proctor-station",
    "setup": [
      {
        "click": "button:has-text('Check In')"
      },
      {
        "waitFor": ".q-dialog"
      },
      {
        "wait": 500
      }
    ],
    "selector": ".q-dialog .q-card",
    "padding": 0,
    "annotate": [
      {
        "selector": ".q-dialog .q-select >> nth=0",
        "n": 1
      },
      {
        "selector": ".q-dialog button:has-text('Randomize')",
        "n": 2
      },
      {
        "selector": ".q-dialog button:has-text('Check in & seat')",
        "n": 3
      }
    ]
  },
  {
    "name": "result-phone",
    "user": "proctor_user",
    "path": "/volunteer/proctor-station",
    "setup": [
      {
        "waitFor": ".run-sheet__winners"
      },
      {
        "wait": 500
      }
    ],
    "selector": ".run-sheet__card:has(.run-sheet__winners) >> nth=0",
    "annotate": [
      {
        "selector": ".run-sheet__card:has(.run-sheet__winners) >> nth=0 >> .run-sheet__winner >> nth=0",
        "n": 1
      }
    ]
  }
]
