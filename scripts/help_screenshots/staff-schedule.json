[
  {
    "name": "board-desktop",
    "user": "staff_user",
    "path": "/admin/schedule",
    "viewport": {
      "width": 1680,
      "height": 1750
    },
    "setup": [
      {
        "wait": 1500
      },
      {
        "click": ".match-filters-card .q-select:has-text('Day')"
      },
      {
        "click": ".q-menu .q-item:has-text(\"All dates\")"
      },
      {
        "wait": 1000
      }
    ],
    "selector": ".schedule-layout__board .match-table",
    "annotate": [
      {
        "selector": ".schedule-layout__board .match-table >> text=Flagged",
        "n": 1
      },
      {
        "selector": ".schedule-layout__board .match-table >> text=/needs crew/ >> nth=1",
        "n": 2
      },
      {
        "selector": ".schedule-layout__board .match-table >> text=/to approve/ >> xpath=..",
        "n": 3,
        "tab": "bottom"
      }
    ]
  },
  {
    "name": "match-sheet",
    "user": "staff_user",
    "path": "/admin/schedule",
    "viewport": "desktop",
    "setup": [
      {
        "wait": 1500
      },
      {
        "click": ".match-filters-card .q-select:has-text('Day')"
      },
      {
        "click": ".q-menu .q-item:has-text(\"All dates\")"
      },
      {
        "wait": 1000
      },
      {
        "click": ".q-table__bottom .q-select"
      },
      {
        "click": ".q-menu .q-item:has-text(\"All\")"
      },
      {
        "wait": 1000
      },
      {
        "click": ".run-sheet__open:has-text(\"Player Four vs Player Two\")"
      },
      {
        "waitFor": ".match-sheet"
      },
      {
        "wait": 800
      }
    ],
    "selector": ".match-sheet",
    "padding": 0,
    "annotate": [
      {
        "selector": ".match-sheet button:has-text('Check in')",
        "n": 1
      },
      {
        "selector": ".match-sheet button:has-text('Assign')",
        "n": 2
      },
      {
        "selector": ".match-sheet button:has-text('Edit match')",
        "n": 3
      }
    ]
  },
  {
    "name": "match-dialog",
    "user": "staff_user",
    "path": "/admin/schedule",
    "viewport": "desktop",
    "setup": [
      {
        "wait": 1500
      },
      {
        "click": ".run-sheet__open:has-text(\"Player Two vs Player Three\")"
      },
      {
        "waitFor": ".match-sheet"
      },
      {
        "click": ".match-sheet button:has-text(\"Edit match\")"
      },
      {
        "waitFor": ".dialog-card:not(.match-sheet)"
      },
      {
        "wait": 800
      }
    ],
    "selector": ".dialog-card:not(.match-sheet)",
    "padding": 0,
    "annotate": [
      {
        "selector": ".dialog-card:not(.match-sheet) .wiz-chip:has-text('Needs review')",
        "n": 1
      }
    ]
  }
]
