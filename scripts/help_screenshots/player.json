[
  {
    "name": "my-schedule-phone",
    "user": "player_one",
    "path": "/home/my-schedule",
    "hide": [
      ".q-footer"
    ],
    "remove": [
      "[aria-label=\"Your volunteer shift\"]"
    ]
  },
  {
    "name": "bracket-schedule-phone",
    "user": "player_one",
    "path": "/home/my-schedule",
    "selector": ".wiz-subcard:has-text(\"Waiting on you to pick a time\")",
    "hide": [
      ".q-footer"
    ],
    "annotate": [
      {
        "selector": ".wiz-subcard:has-text(\"Waiting on you to pick a time\") >> button:has-text(\"Pick a time\")",
        "n": 1
      }
    ]
  },
  {
    "name": "ask-to-change-phone",
    "user": "player_one",
    "path": "/home/my-schedule",
    "setup": [
      {
        "click": "button[aria-label^=\"More for\"] >> nth=1"
      },
      {
        "click": "text=Ask to change"
      },
      {
        "waitFor": ".q-dialog"
      }
    ],
    "selector": ".q-dialog .q-card",
    "padding": 0
  },
  {
    "name": "running-late-phone",
    "user": "player_one",
    "path": "/home/my-schedule",
    "setup": [
      {
        "click": "button:has-text('Running late')"
      },
      {
        "waitFor": ".q-dialog"
      },
      {
        "wait": 500
      }
    ],
    "selector": ".q-dialog .q-card",
    "padding": 0
  }
]
