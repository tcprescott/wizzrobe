[
  {
    "name": "my-shifts-phone",
    "user": "player_two",
    "path": "/home/my-schedule?shifts=1",
    "selector": ".wiz-panel:has(#my-shifts)",
    "hide": [
      ".q-footer",
      ".q-header"
    ],
    "annotate": [
      {
        "selector": "#my-shifts button:has-text(\"I'm here\") >> nth=0",
        "n": 1
      },
      {
        "selector": "#my-shifts .wiz-shift-finished .q-item",
        "n": 2
      }
    ]
  },
  {
    "name": "release-phone",
    "user": "sm_user",
    "path": "/home/my-schedule?shifts=1",
    "setup": [
      {
        "click": "#my-shifts .wiz-shift-row__actions button >> nth=-1"
      },
      {
        "click": "text=Can't make it\u2026"
      },
      {
        "waitFor": ".q-dialog .q-card:has-text('Give it back')"
      },
      {
        "wait": 500
      }
    ],
    "selector": ".q-dialog .q-card",
    "padding": 0,
    "annotate": [
      {
        "selector": ".q-dialog .q-field__control:has(textarea)",
        "n": 1
      },
      {
        "selector": ".q-dialog button:has-text('Give it back')",
        "n": 2
      }
    ]
  }
]
