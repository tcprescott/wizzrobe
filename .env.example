# Database — DB_HOST and DB_PORT are set automatically by docker-compose
DB_NAME=wizzrobe
DB_USERNAME=wizzrobe
DB_PASSWORD=changeme

# Discord bot
DISCORD_TOKEN=your-discord-bot-token-here

# Discord OAuth (required for web login — obtain from Discord Developer Portal)
DISCORD_CLIENT_ID=your-discord-application-client-id
DISCORD_CLIENT_SECRET=your-discord-application-client-secret
# Base URL of this app — used for deep links (QR codes, DM links) and to derive
# PLATFORM_HOST when it is unset. For local dev the default is http://localhost:8000
# (no need to set it).
BASE_URL=https://yourdomain.com
# REDIRECT_URL and OAUTH_URL are derived automatically. The OAuth callback is built
# from PLATFORM_HOST (the host that actually serves it), NOT BASE_URL — so a legacy
# value in BASE_URL can't misdirect the callback. OAUTH_URL is built from
# DISCORD_CLIENT_ID + the derived callback. Override only for a non-standard value.
# REDIRECT_URL=https://yourdomain.com/oauth/callback
# OAUTH_URL=https://discord.com/api/oauth2/authorize?client_id=...&redirect_uri=...&response_type=code&scope=identify

# NiceGUI session storage — REQUIRED. Signs the session that holds auth state.
# Generate a strong random value, e.g. `python -c "import secrets; print(secrets.token_urlsafe(32))"`
STORAGE_SECRET=your-storage-secret-here

# App
ENVIRONMENT=production
# Root level for the application logger (uvicorn's own --log-level is pinned to
# info by start.sh). One of DEBUG / INFO / WARNING / ERROR / CRITICAL.
# LOG_LEVEL=INFO
# Shared platform host (bare host[:port], no scheme) that serves the landing
# page, the /platform super-admin surface, and every tenant path-based at
# /t/<slug>. Defaults to the host component of BASE_URL when unset. A request
# whose Host matches a tenant's custom domain (set on /platform) instead resolves
# to that tenant directly (host mode); any other host serves the platform surface.
# PLATFORM_HOST=yourdomain.com
# Honor X-Forwarded-Host / X-Forwarded-Proto for host + scheme resolution. OFF by
# default because a client can forge them; turn ON only behind a trusted proxy
# that sets them. Required when the proxy rewrites Host rather than forwarding it
# verbatim, so custom-domain (host-mode) routing works. This is the host/scheme
# analogue of TRUST_PROXY_FORWARDED_FOR (which governs client-IP for rate
# limiting); a proxy deployment typically wants both.
# TRUST_FORWARDED_HOST=true
# Custom-domain login mode. 'local' (default) = Design A: Discord OAuth completes
# on the custom domain, so each domain's https://<domain>/oauth/callback must be
# registered as a Discord redirect URI. 'handoff' = Design B: OAuth always runs on
# the platform host (one registered URI regardless of domain count) and a
# short-lived signed token hands the session to the custom domain. Switch to
# handoff once custom-domain count nears the provider's redirect-URI ceiling.
# In 'handoff' mode the profile identity links (racetime / Twitch / Challonge
# player-link) ride the same handoff and work on custom domains; in 'local' they
# stay main-site-only.
# HOST_OAUTH_MODE=local
# MOCK_DISCORD=true   # bypasses Discord OAuth and stubs DiscordService (local dev only;
#                       refused at startup when ENVIRONMENT=production)

# Error monitoring (optional) — set to your Sentry DSN to enable Sentry reporting.
# No-op when blank. Events are tagged with the ENVIRONMENT value above.
# SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
# SENTRY_TRACES_SAMPLE_RATE=0   # >0 enables performance tracing (errors-only by default)

# Device notifications (web push) — optional. Generate a keypair once with
# `poetry run python scripts/generate_vapid_keys.py`. The feature (and its
# settings UI) stays off while VAPID_PRIVATE_KEY is unset. Keep the private key
# secret and stable: rotating it invalidates every existing subscription.
# VAPID_PRIVATE_KEY=base64url-encoded-32-byte-private-key
# VAPID_SUBJECT=mailto:you@example.com   # contact sent to push services; defaults to BASE_URL when https

# Seed generation — randomizer API keys are NOT environment variables. Each
# community supplies its own on Admin -> Randomizer Keys (stored per tenant); a
# randomizer stays hidden from the seed-generator selectors until its key is set.
# MOCK_SEEDGEN=true   # returns fake seed permalinks instead of rolling real seeds
#                       (qualifier pool rolling + any generate_seed caller); local
#                       dev / browser-validation only, refused when ENVIRONMENT=production

# Challonge integration (optional) — register an app at https://connect.challonge.com
# and add the redirect URI below to it. Without these the Challonge features stay off.
# CHALLONGE_CLIENT_ID=your-challonge-oauth-client-id
# CHALLONGE_CLIENT_SECRET=your-challonge-oauth-client-secret
# Redirect URI is derived from BASE_URL when unset. One URI serves both the
# service-account connection and per-player identity linking:
# CHALLONGE_REDIRECT_URI=https://yourdomain.com/challonge/oauth/callback
# CHALLONGE_SCOPES=me tournaments:read tournaments:write matches:read matches:write participants:read participants:write communities:manage
# MOCK_CHALLONGE=true   # fakes the Challonge connection for local dev (refused in production)
# MOCK_CHALLONGE_IDENTITY=1   # which canned mock participant the next link binds to (1-4)

# start.gg (optional) — read-only mirror of a start.gg event, plus player account linking.
# STARTGG_API_TOKEN is a Personal Access Token (start.gg → Developer Settings); the sync
# reads events with it, and the optional per-tournament result writeback reports with it.
# The OAuth app (start.gg → Developer Settings → OAuth) is for players linking their
# account; its redirect URI is <platform host>/startgg/oauth/callback.
# STARTGG_API_TOKEN=your-startgg-personal-access-token
# STARTGG_CLIENT_ID=your-startgg-oauth-client-id
# STARTGG_CLIENT_SECRET=your-startgg-oauth-client-secret
# STARTGG_REDIRECT_URI=https://yourdomain.com/startgg/oauth/callback
# MOCK_STARTGG=true   # canned start.gg event and identity for local dev (refused in production)
# MOCK_STARTGG_IDENTITY=1   # which canned start.gg account the next link binds to (1-2)

# Twitch account linking (optional) — register an app at https://dev.twitch.tv/console/apps
# and add the redirect URI below to it. Without these the Twitch link feature stays off.
# TWITCH_CLIENT_ID=your-twitch-oauth-client-id
# TWITCH_CLIENT_SECRET=your-twitch-oauth-client-secret
# Redirect URI is derived from BASE_URL when unset:
# TWITCH_REDIRECT_URI=https://yourdomain.com/twitch/oauth/callback
# MOCK_TWITCH=true   # fakes the Twitch link for local dev (refused in production)
# MOCK_STRIPE=true   # ticket sales: fake Stripe store calls (refused in production)
# MOCK_PAYPAL=true   # ticket sales: fake PayPal store calls (refused in production)
# MOCK_TWITCH_IDENTITY=1   # which canned mock identity the next link binds to (1-4)

# Matcherino event check-in: each community saves its own Matcherino login on
# Admin → Check-in (MATCHERINO_REFRESH_TOKEN is no longer read).
# MOCK_MATCHERINO=true   # fakes the venue's badge sales for local dev (refused in production)

# racetime.gg account linking (optional) — register an OAuth app at
# https://racetime.gg/account/apps (read scope). These credentials are the
# identity-link OAuth app ONLY — the race-room bots use their own per-category
# client id/secret (RacetimeBot rows), not these. Without these the racetime link
# feature stays off.
# RACETIME_CLIENT_ID=your-racetime-oauth-client-id
# RACETIME_CLIENT_SECRET=your-racetime-oauth-client-secret
# Redirect URI is derived from BASE_URL when unset:
# RACETIME_REDIRECT_URI=https://yourdomain.com/racetime/oauth/callback
# MOCK_RACETIME=true   # fakes the racetime link for local dev (refused in production)
# MOCK_RACETIME_IDENTITY=1   # which canned mock identity the next link binds to (1-4)

# --- MCP server -------------------------------------------------------------
# Remote MCP endpoint at /mcp for Claude Desktop / Claude Code. Read-only, and
# OAuth-only (personal API tokens are refused there). On by default; set this to
# false to remove the route, its OAuth endpoints, and its discovery documents.
# BASE_URL must be the public URL — it is the MCP resource identifier and the
# OAuth issuer, both of which clients compare against what they requested.
# See docs/features/mcp-server.md.
# MCP_ENABLED=false
